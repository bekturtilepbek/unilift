# Скопировать в .env и заполнить реальными значениями. .env в git не попадает.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=unilift.site,www.unilift.site
DJANGO_CSRF_TRUSTED_ORIGINS=https://unilift.site,https://www.unilift.site

# --- База данных (по умолчанию — SQLite) ---
# Чтобы переключиться на Postgres, раскомментировать:
# DATABASE_URL=postgres://user:password@host:5432/unilift

# --- Домен ---
DOMAIN=unilift.site

# --- Email (опционально) ---
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@unilift.site

# --- Sentry (опционально) ---
SENTRY_DSN=