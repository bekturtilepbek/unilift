# --- Заголовок / мета ---
msgid "Unilift — Официальный дистрибьютор Schindler в Кыргызстане"
msgstr "Unilift — Schindler компаниясынын Кыргызстандагы расмий дистрибьютору"

msgid "Поставка, монтаж и сервисное обслуживание лифтов, эскалаторов и подъёмного оборудования Schindler в Кыргызстане."
msgstr "Schindler лифттерин, эскалаторлорун жана көтөрүү жабдууларын Кыргызстанда жеткирүү, орнотуу жана тейлөө."

# --- Hero ---
msgid "Официальный дистрибьютор <span class=\"accent\">Schindler</span> в Кыргызстане"
msgstr "<span class=\"accent\">Schindler</span> компаниясынын Кыргызстандагы расмий дистрибьютору"

msgid "Более 8 лет поставляем, устанавливаем и обслуживаем лифты, эскалаторы и подъёмное оборудование. Безопасные решения для вертикального транспорта — на объектах любого масштаба."
msgstr "8 жылдан ашык убакыттан бери лифттерди, эскалаторлорду жана көтөрүү жабдууларын жеткиребиз, орнотобуз жана тейлейбиз. Каалаган масштабдагы объекттер үчүн вертикалдык транспорттун коопсуз чечимдери."

# --- Stats ---
msgid "лет на рынке вертикального транспорта"
msgstr "жыл вертикалдык транспорт рыногунда"

msgid "года — официальный дистрибьютор Schindler"
msgstr "жыл — Schindler компаниясынын расмий дистрибьютору"

msgid "оригинальное оборудование и запчасти"
msgstr "оригиналдуу жабдуулар жана запчасттар"

msgid "отраслей: от жилья до госсектора"
msgstr "тармак: турак үйдөн мамлекеттик секторго чейин"

# --- О компании / Партнёрство ---
msgid "Надёжный партнёр в вертикальном транспорте"
msgstr "Вертикалдык транспорттогу ишенимдүү өнөктөш"

msgid "Уже более двух лет Unilift является официальным дистрибьютором Schindler — одного из мировых лидеров в производстве лифтов, эскалаторов и решений для городской мобильности."
msgstr "Unilift компаниясы эки жылдан ашык убакыттан бери лифттерди, эскалаторлорду жана шаардык мобилдүүлүк чечимдерин өндүрүүдө дүйнөлүк лидерлердин бири болгон Schindler компаниясынын расмий дистрибьютору болуп саналат."

msgid "Статус официального дистрибьютора позволяет нам поставлять оригинальное оборудование, применять международные стандарты и обеспечивать высокий уровень технической поддержки на каждом объекте."
msgstr "Расмий дистрибьютор статусу бизге оригиналдуу жабдууларды жеткирүүгө, эл аралык стандарттарды колдонууга жана ар бир объектте техникалык колдоонун жогорку деңгээлин камсыз кылууга мүмкүнчүлүк берет."

msgid "Оригинальное оборудование"
msgstr "Оригиналдуу жабдуулар"

msgid "Поставляем технику Schindler напрямую от производителя, без посредников."
msgstr "Schindler техникасын өндүрүүчүдөн түз, ортомчусуз жеткиребиз."

msgid "Международные стандарты"
msgstr "Эл аралык стандарттар"

msgid "Применяем мировые стандарты качества и безопасности на каждом этапе."
msgstr "Ар бир этапта дүйнөлүк сапат жана коопсуздук стандарттарын колдонобуз."

msgid "Соблюдение сроков"
msgstr "Мөөнөттөрдү сактоо"

msgid "Планируем и выполняем работы в согласованные сроки без потери качества."
msgstr "Иштерди сапатын жоготпостон, макулдашылган мөөнөттөрдө пландайбыз жана аткарабыз."

msgid "Техническая поддержка"
msgstr "Техникалык колдоо"

msgid "Оригинальные запчасти и доступ к инженерным решениям Schindler."
msgstr "Оригиналдуу запчасттар жана Schindler компаниясынын инженердик чечимдерине жетки."

# --- Оборудование (Products) ---
msgid "Решения для любого типа здания"
msgstr "Каалаган түрдөгү имарат үчүн чечимдер"

msgid "Подбираем и поставляем оборудование под задачи объекта — от малоэтажной жилой застройки до высоконагруженных общественных пространств."
msgstr "Объекттин милдеттерине жараша жабдууларды тандап, жеткиребиз — аз кабаттуу турак жайлардан жогорку жүктөлгөн коомдук мейкиндиктерге чейин."

msgid "Пассажирские лифты"
msgstr "Жүргүнчү лифттери"

msgid "Для жилых комплексов, офисов, гостиниц и общественных зданий любой этажности."
msgstr "Каалаган кабаттуулуктагы турак комплекстер, кеңселер, мейманканалар жана коомдук имараттар үчүн."

msgid "Грузовые лифты"
msgstr "Жүк лифттери"

msgid "Повышенная грузоподъёмность для промышленных, торговых и медицинских объектов."
msgstr "Өнөр жай, соода жана медициналык объекттер үчүн жогорулатылган жүк көтөрүмдүүлүк."

msgid "Эскалаторы"
msgstr "Эскалаторлор"

msgid "Безопасная и надёжная мобильность для ТЦ, вокзалов и деловых центров."
msgstr "Соода борборлору, вокзалдар жана бизнес-борборлор үчүн коопсуз жана ишенимдүү мобилдүүлүк."

msgid "Траволаторы"
msgstr "Траволаторлор"

msgid "Горизонтальный и наклонный транспорт для протяжённых пространств."
msgstr "Узакка созулган мейкиндиктер үчүн горизонталдык жана ийкемдүү транспорт."

msgid "Модернизация"
msgstr "Модернизация"

msgid "Обновление действующего оборудования: производительность, безопасность, эстетика."
msgstr "Иштеп жаткан жабдууларды жаңылоо: өндүрүмдүүлүк, коопсуздук, эстетика."

msgid "Подбор под ключ"
msgstr "Ачкыч менен тапшыруу"

msgid "Инженерный расчёт и подбор оптимальной конфигурации под ваш объект."
msgstr "Сиздин объектиңиз үчүн инженердик эсептөө жана оптималдуу конфигурацияны тандоо."

# --- Полный цикл (Services) ---
msgid "От подбора оборудования до сервиса"
msgstr "Жабдууну тандоодон тейлөөгө чейин"

msgid "Ведём проект на каждом этапе — как единый подрядчик, отвечающий за результат от первого расчёта до планового обслуживания."
msgstr "Долбоорду ар бир этапта жетектейбиз — биринчи эсептөөдөн пландуу тейлөөгө чейинки натыйжа үчүн жооп берген бирдиктүү подрядчик катары."

msgid "Подбор и проектирование"
msgstr "Тандоо жана долбоорлоо"

msgid "Анализируем задачи объекта и подбираем оптимальное оборудование и конфигурацию."
msgstr "Объекттин милдеттерин талдап, оптималдуу жабдууну жана конфигурацияны тандайбыз."

msgid "Поставка оборудования"
msgstr "Жабдууну жеткирүү"

msgid "Организуем поставку в согласованные сроки, с полным пакетом документов и заводской гарантией."
msgstr "Жеткирүүнү макулдашылган мөөнөттөрдө, толук документ пакети жана заводдук кепилдик менен уюштурабыз."

msgid "Монтаж и пусконаладка"
msgstr "Монтаж жана ишке киргизүү"

msgid "Профессиональный монтаж с приёмо-сдаточными испытаниями на каждом этапе."
msgstr "Ар бир этапта кабыл алуу-өткөрүп берүү сыноолору менен кесипкөй монтаж."

msgid "Ввод в эксплуатацию"
msgstr "Пайдаланууга берүү"

msgid "Испытания, приёмка и оформление — оборудование готово к безопасной работе."
msgstr "Сыноолор, кабыл алуу жана таризделме — жабдуу коопсуз иштөөгө даяр."

msgid "Сервисное обслуживание"
msgstr "Тейлөө кызматы"

msgid "Плановое обслуживание и оперативная поддержка для бесперебойной работы."
msgstr "Үзгүлтүксүз иштөө үчүн пландуу тейлөө жана ыкчам колдоо."

# --- Отрасли (Industries) ---
msgid "Работаем с объектами любого назначения"
msgstr "Каалаган багыттагы объекттер менен иштейбиз"

msgid "За годы работы мы реализовали проекты в самых разных сегментах и знаем требования каждого из них."
msgstr "Иштеген жылдарыбызда ар түрдүү сегменттерде долбоорлорду ишке ашырдык жана ар бирине коюлган талаптарды билебиз."

msgid "Жилые комплексы"
msgstr "Турак комплекстер"

msgid "Бизнес-центры"
msgstr "Бизнес-борборлор"

msgid "Гостиницы"
msgstr "Мейманканалар"

msgid "Медучреждения"
msgstr "Медициналык мекемелер"

msgid "Торговые центры"
msgstr "Соода борборлору"

msgid "Промпредприятия"
msgstr "Өнөр жай ишканалары"

msgid "Гособъекты"
msgstr "Мамлекеттик объекттер"

msgid "Другие объекты"
msgstr "Башка объекттер"

# --- Проекты (лендинг + каталог) ---
msgid "Реализованные проекты"
msgstr "Ишке ашырылган долбоорлор"

msgid "Проекты появятся здесь в ближайшее время."
msgstr "Долбоорлор жакында бул жерде пайда болот."

msgid "Фото объекта"
msgstr "Объекттин сүрөтү"

msgid "На главную"
msgstr "Башкы бетке"

# --- Контакты ---
msgid "Обсудим ваш объект"
msgstr "Объектиңизди талкуулайлы"

msgid "Опишите задачу в WhatsApp — ответим и предложим решение в течение рабочего дня."
msgstr "Милдетти WhatsApp'та жазыңыз — жумуш күнүнүн ичинде жооп берип, чечим сунуштайбыз."

# --- Футер ---
msgid "Официальный дистрибьютор Schindler в Кыргызстане"
msgstr "Schindler компаниясынын Кыргызстандагы расмий дистрибьютору"

msgid "Поставка, монтаж и сервисное обслуживание лифтов, эскалаторов и подъёмного оборудования."
msgstr "Лифттерди, эскалаторлорду жана көтөрүү жабдууларын жеткирүү, орнотуу жана тейлөө."